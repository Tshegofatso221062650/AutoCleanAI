# ── Security ──────────────────────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-in-production-use-long-random-string

# Owner / single-user password (used when multi-user auth is enabled)
AUTOCLEAN_PASSWORD=changeme

# Set to true for local single-user dev use (skips all auth). NEVER true in prod.
AUTOCLEAN_DISABLE_AUTH=false

# Prevent self-registration — admin creates accounts manually
DISABLE_REGISTRATION=false

# Max upload size in MB (0 = unlimited)
MAX_UPLOAD_MB=500

# Max datasets per user (0 = unlimited)
MAX_DATASETS_PER_USER=0

# Comma-separated list of allowed CORS origins
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ── AI Chat ───────────────────────────────────────────────────────────────────
# Options: openai | ollama | none
AI_PROVIDER=ollama

# OpenAI (used when AI_PROVIDER=openai)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Ollama (used when AI_PROVIDER=ollama — make sure Ollama is running locally)
# Install Ollama: https://ollama.com/download
# Then run: ollama pull phi3:mini
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=phi3:mini
OLLAMA_TIMEOUT=300.0

# ── SMTP / Email Notifications ────────────────────────────────────────────────
# Leave SMTP_HOST empty to disable email notifications entirely.
# Example for Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, SMTP_TLS=true
# For Gmail you need an App Password: https://myaccount.google.com/apppasswords
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_TLS=true

# ── Database (optional) ───────────────────────────────────────────────────────
# Leave empty to use the default local SQLite file (recommended for single user).
# Switch to PostgreSQL for multi-user / production:
#   DATABASE_URL=postgresql://user:password@host:5432/autoclean
DATABASE_URL=
