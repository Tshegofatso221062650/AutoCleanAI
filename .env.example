# Backend: copy to backend/.env (run uvicorn from the backend folder)
SECRET_KEY=replace-with-long-random-string

# true = no password (default for Personal Edition). false = require AUTOCLEAN_PASSWORD login
AUTOCLEAN_DISABLE_AUTH=true
AUTOCLEAN_PASSWORD=your-local-password

# AI (optional)
AI_PROVIDER=ollama
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=mistral
